{
  "primitive": "array",
  "valuesFrom": "memo",
  "pointers": [
    { "name": "amt", "var": "amt" }
  ],
  "flags": {
    "solving": "amt != null"
  },
  "cellStateRules": [
    { "state": "current", "when": "idx == amt" },
    { "state": "result", "when": "values[idx] < inf" },
    { "state": "idle", "when": "true" }
  ],
  "ghosts": { "track": ["amt"] },
  "readout": {
    "when": "amt != null",
    "expr": "fewest coins for amount {amt}",
    "relation": "best so far {best}",
    "relationColor": "result"
  },
  "counters": [
    { "name": "subproblem visits", "onLines": [12] },
    { "name": "memo hits", "onLines": [15] }
  ],
  "phaseRules": [
    { "phase": "init", "lines": [3, 4, 5] },
    { "phase": "recurse", "lines": [6, 19] },
    { "phase": "check", "lines": [7, 12, 14, 18, 21] },
    { "phase": "update", "lines": [8, 16, 20, 22, 23] },
    { "phase": "loop", "lines": [17] },
    { "phase": "return", "lines": [9, 13, 15, 24] }
  ],
  "keyEvents": [
    { "line": 15, "label": "Reused a memoized answer", "kind": "match" },
    { "line": 23, "label": "Sub-amount solved", "kind": "result" },
    { "line": 9, "label": "Final answer", "kind": "return" }
  ]
}
